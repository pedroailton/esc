/**
 * Represents a Pong game.
 */
class PongGame {

    static PongGame instance; // the singelton, a Pong game instance     
    field Bat bat_cima;       // objeto bat_cima da classe Bat
    field Bat bat_baixo;      // objeto bat_baixo da classe Bat
    field Ball ball;          // objeto ball da classe Ball
    field int wall;           // the current wall that the ball is bouncing off of.
    field boolean exit;       // true when the game is over
    field boolean repetir;    // true por padrão, até o usuário sair do programa quando o jogo acabar
    field int p1Score;        // the P1 current score.
    field int p2Score;	      // the P2 current score
    field int lastWall;       // the last wall that the ball bounced off of.
    field int bat_cima_width;
    field int bat_baixo_width;

    // The current width of the bat
    field int batWidth;

    /** Constructs a new Pong game. */
    constructor PongGame new() {
	    do Screen.clearScreen();

        let bat_cima_width = 50;  // initial bat_cima size
	    let bat_baixo_width = 50; // initial bat_baixo size
        let bat_cima = Bat.new(230, 8, bat_baixo_width, 7);
	    let bat_baixo = Bat.new(230, 229, bat_cima_width, 7);
        let ball = Ball.new(253, 222, 0, 511, 16, 229);

        do ball.setDestination(200, -100); // destino inicial para onde a bola deve ir
        do Screen.drawRectangle(0, 238, 511, 240); // Barra horizontal inferior
	    do Screen.drawRectangle(0, 4, 511, 6); // Barra horizontal superior
	
	    let exit = false;
	    let p1Score = 0;
        let p2Score = 0;
	    let wall = 0;
	    let lastWall = 0;

        return this;
    }

    /** Deallocates the object's memory. */
    method void dispose() {
        do bat_baixo.dispose();
        do bat_cima.dispose();
	    do ball.dispose();
        do Memory.deAlloc(this);
        return;
    }

    /** Creates an instance of Pong game, and stores it. */
    function void newInstance() {
        let instance = PongGame.new();
        return;
    }
    
    /** Retorna uma única instância desse PongGame */
    function PongGame getInstance() {
        return instance;
    }

    /** Começa o jogo*/
    method void run() {
        var char key; // variável que vai receber os valores lidos das teclas do teclado

        // Printando pontuação no display
	    do Output.moveCursor(22,0); // move o cursor de escrita da string para a linha 22 (de 23 totais)
	    do Output.printString("Score: P1: X / P2: X");
        do Output.moveCursor(22, 12);
        do Output.printInt(p1Score);
        do Output.moveCursor(22, 20);
        do Output.printInt(p2Score);

        // O loop abaixo se repete enquanto o jogador não fechar e quiser repetir o jogo
        while (~exit & ~repetir) {
	        // Primeiro loop do jogo: "inércia" no movimento dos objetos quando não há tecla pressionada
            while ((key = 0) & (~exit)) {
                let key = Keyboard.keyPressed(); // a tecla do teclado é lida
                do bat_cima.move(); // a raquete de cima se move
		        do bat_baixo.move(); // a raquete de baixo se move
                do moveBall(); // a bola se move, a partir dos métodos PongGame.moveBall() e Ball.move()
                do Sys.wait(1);
            }

            // verifica teclado para mover bat de baixo (tecla a (97) -> esquerda; tecla d (100) -> direita)
            if (key = 97) {do bat_baixo.setDirection(1);}
            else {if (key = 100) {do bat_baixo.setDirection(2);}}

            // verifica teclado para mover bat de cima (tecla flecha para esquerda (130) e tecla flecha para direita (132))
            if (key = 130) {do bat_cima.setDirection(1);}
            else {if (key = 132) {do bat_cima.setDirection(2);}}

            // verifica teclado para encerrar o jogo (tecla ESC (140))
            if (key = 140) {let exit = true;}

            // Executada quando uma tecla é pressionada
            while ((~(key = 0)) & (~exit)) {
                let key = Keyboard.keyPressed();
                do bat_cima.move();
                do bat_baixo.move();
                do moveBall();
                do Sys.wait(1); // "segura" o processamento por 10 milisegundos (0,005 segundos)
            }

            // se a tecla ESC for pressionada ou a bola colidir com a parede de cima ou de baixo
            if (exit & wall = 4) {
                let p1Score = p1Score + 1;
                do instance.finalScreen();
            }
            if (exit & wall = 3) {
                let p2Score = p2Score + 1;
                do instance.finalScreen();
            }
        }
        return;
    }

    /**
     * Handles ball movement, including bouncing.
     * If the ball bounces off a wall, finds its new direction.
     * If the ball bounces off the bat, increases the score by one
     * and shrinks the bat's size, to make the game more challenging. 
     */
    method void moveBall() {
        var int bouncingDirection, batCimaLeft, batCimaRight, batBaixoLeft, batBaixoRight, ballLeft, ballRight;
        
        // 1. Tenta mover a bola. E 'wall' recebe 0 se não bateu, ou 1-4 se bateu.
        let wall = ball.move();

        // 2. Só processa o ricochete se houve colisão (wall > 0) E se não é a mesma parede do frame anterior (lastWall)
        if ((wall > 0) & (~(wall = lastWall))) {
            let lastWall = wall; // atualiza que a última parede tocada é a atual
            let bouncingDirection = 0; // 0 = centro, -1 = esquerda, 1 = direita
            
            // métodos get de busca de atributos das bats (raquetes) e da ball (bola)
            // cada atributo left é a coordenada x mais à esquerda do objeto
            // e cada atributo right é a coordenada x mais à direita do objeto
            let batCimaLeft = bat_cima.getLeft();
            let batCimaRight = bat_cima.getRight();
            let batBaixoLeft = bat_baixo.getLeft();
            let batBaixoRight = bat_baixo.getRight();
            let ballLeft = ball.getLeft();
            let ballRight = ball.getRight();

            // Se a bola tocar na parede superior (wall 3)
            if (wall = 3) {
                // Verifica se a bola passou pela raquete (exit = true se a bola não tocou no bat)
                // Para isso usa a lógica da coordenada mais a direita da bola ser menor do que a mais à esquerda da raquete, e vice-versa
                let exit = (batCimaLeft > ballRight) | (batCimaRight < ballLeft);

                if (~exit) {
                    // Colisão com a quina esquerda da raquete
                    if (ballRight < (batCimaLeft + 10)) { 
                        let bouncingDirection = -1;
                    }
                    else {
                        // Colisão com a quina direita da raquete
                        if (ballLeft > (batCimaRight - 10)) { 
                            let bouncingDirection = 1;
                        }
                    }
                }
            }
            else {
                // Se a bola tocar na parede inferior (wall 4)
                if (wall = 4) {
                    // Verifica se a bola passou pela raquete
                    // mesma lógica da raquete superior
                    let exit = (batBaixoLeft > ballRight) | (batBaixoRight < ballLeft);

                    // Caso a bola tenha tocado na raquete, aplica a lógica de rebatimento
                    if (~exit) {
                        // Se tocou na quina da esquerda da raquete
                        if (ballRight < (batBaixoLeft + 10)) { 
                            let bouncingDirection = -1; // bola rebatida na diagonal esquerda
                        }
                        else {
                            // Se tocou na quina da direita da raquete
                            if (ballLeft > (batBaixoRight - 10)) { 
                                let bouncingDirection = 1; // bola rebatida na diagonal direita
                            }
                            else {
                                // Caso tenha tocado no centro da raquete (bat)
                                let bouncingDirection = 0; // bola rebatida ao centro
                            }
                        }
                    }
                }
            }
            // Processa o método de ball para rebatimento
            do ball.bounce(bouncingDirection);
        }
        return;
    }

    method void finalScreen() {
        var char key;

        let key = 0;	

        do Output.moveCursor(11, 18); // issue: centralizar essas duas mensagens na tela
        do Output.printString("Pressione ESC para Sair");
        do Output.moveCursor(13, 15);
        do Output.printString("Pressione SPACE para Jogar Novamente");

        while(~(key = 140) & ~(key = 32)) {
            let key = Keyboard.keyPressed();
        }
        // Se ESC for pressionado, o repetir também acaba
        if (key = 140) {
            let repetir = false; // variável de controle de repetição define que o run termine definitivamente
        }
        else {
            if (key = 32) {
                do Screen.clearScreen(); // Limpa a tela
                let exit = false; // variável de controle reinicia o exit para que o run rode novamente normalmente

                // RESETA A BOLA (Destrói a antiga e cria uma nova no centro)
                do ball.dispose();
                let ball = Ball.new(253, 222, 0, 511, 8, 229);
                do ball.setDestination(200, -100); // Define o primeiro movimento

                // RESETA VARIÁVEIS DE CONTROLE
                let wall = 0;
                let lastWall = 0;

                // REDESENHA A TELA
                do Screen.clearScreen(); 
                do Screen.drawRectangle(0, 238, 511, 240); // Barra inferior
                do Screen.drawRectangle(0, 4, 511, 6);     // Barra superior
                
                // Redesenha o placar com os valores ACUMULADOS
                do Output.moveCursor(22,0);
                do Output.printString("Score: P1: ");
                do Output.printInt(p1Score);
                do Output.printString(" / P2: ");
                do Output.printInt(p2Score);
            }
        }
        return;
    }

}