/**
 * Represents a Pong game.
 */
class PongGame {

    static PongGame instance; // the singelton, a Pong game instance     
    field Bat bat_cima;       // objeto bat_cima da classe Bat
    field Bat bat_baixo;      // objeto bat_baixo da classe Bat
    field Ball ball;          // objeto ball da classe Ball
    field int wall;           // the current wall that the ball is bouncing off of.
    field boolean exit;       // true when the game is over
    field boolean repetir;    // true por padrão, até o usuário sair do programa quando o jogo acabar
    field int p1Score;        // the P1 current score.
    field int p2Score;	      // the P2 current score
    field int lastWall;       // the last wall that the ball bounced off of.
    field int bat_cima_width;
    field int bat_baixo_width;

    // The current width of the bat
    field int batWidth;

    /** Constructs a new Pong game. */
    constructor PongGame new() {
	    do Screen.clearScreen();
        let bat_cima_width = 50;  // initial bat_cima size
	    let bat_baixo_width = 50; // initial bat_baixo size
        let bat_baixo = Bat.new(230, 229, batWidth, 7);
	    let bat_cima = Bat.new(8, 229, batWidth, 7);
        let ball = Ball.new(253, 222, 0, 511, 0, 229);
        do ball.setDestination(400,0);
        do Screen.drawRectangle(0, 238, 511, 240); // Barra horizontal inferior
	do Screen.drawRectangle(0, 4, 511, 6); // Barra horizontal superior
	    // Printando os valores de pontuação iniciais
	    do Output.moveCursor(22,0); // move o cursor de escrita da string para a linha 22 (de 23 totais)
	    do Output.printString("Score: P1: 0 / P2: 0");
	
	    let exit = false;
	    let p1Score = 0;
        let p2Score = 0;
	    let wall = 0;
	    let lastWall = 0; // o que é "lastWall"?

        return this;
    }

    /** Deallocates the object's memory. */
    method void dispose() {
        do bat_baixo.dispose();
        do bat_cima.dispose();
	    do ball.dispose();
        do Memory.deAlloc(this);
        return;
    }

    /** Creates an instance of Pong game, and stores it. */
    function void newInstance() {
        let instance = PongGame.new();
        return;
    }
    
    /** Returns the single instance of this Pong game. */
    function PongGame getInstance() {
        return instance;
    }

    /** Starts the game, and andles inputs from the user that control
     *  the bat's movement direction. */
    method void run() {
        var char key;

        while (~exit & ~repetir) {
	    // Loop de "inércia" no movimento dos objetos quando não há tecla pressionada
            while ((key = 0) & (~exit)) {
                let key = Keyboard.keyPressed();
                do bat_cima.move();
		do bat_baixo.move();
                do moveBall();
                do Sys.wait(50); // 
            }

	    // verifica teclado para mover bat de baixo
            if (key = 130) {do bat_baixo.setDirection(1);}
	    else {if (key = 132) {do bat_baixo.setDirection(2);}}

	    // verifica teclado para mover bat de cima (tecla a (97) -> esquerda; tecla d (100) -> direita)
	    if (key = 97) {do bat_cima.setDirection(1);}
	    else {if (key = 100) {do bat_cima.setDirection(2);}}

	    // verifica teclado para encerrar o jogo (tecla ESC (140))
	    if (key = 140) {let exit = true;}

            // Executada quando uma tecla é pressionada
            while ((~(key = 0)) & (~exit)) {
                let key = Keyboard.keyPressed();
                do bat_cima.move();
		do bat_baixo.move();
                do moveBall();
                do Sys.wait(50); // "segura" o processamento por 50 milisegundos (0,05 segundos)
            }
        }

	    // se a tecla ESC for pressionada ou a bola colidir com a parede de cima ou de baixo
	    if (exit & wall = 4) {
		    let p1Score = p1Score + 1;
	        do instance.finalScreen(); // será que deixo o this aqui?
	    }
	    else {
            if (exit & wall = 3) {
                let p2Score = p2Score + 1;
                do instance.finalScreen();
            }
	    }
        return;
    }

    /**
     * Handles ball movement, including bouncing.
     * If the ball bounces off a wall, finds its new direction.
     * If the ball bounces off the bat, increases the score by one
     * and shrinks the bat's size, to make the game more challenging. 
     */
    method void moveBall() {
        var int bouncingDirection, batCimaLeft, batCimaRight, batBaixoLeft, batBaixoRight, ballLeft, ballRight;

        let wall = ball.move();

        if ((wall > 0) & (~(wall = lastWall))) {
            let lastWall = wall;
            let bouncingDirection = 0; // por padrão a bola é rebatida para o centro, cf. método .bounce() em Ball.jack
            let batCimaLeft = bat_cima.getLeft();
            let batCimaRight = bat_cima.getRight();
	        let batBaixoLeft = bat_baixo.getLeft();
	        let batBaixoRight = bat_baixo.getRight();
            let ballLeft = ball.getLeft();
            let ballRight = ball.getRight();
  
	        // Se a bola tocar na parede superior
            if (wall = 3) {
		        // boolean "exit" se refere a quando a bola não toca no bat
		        // Ou seja, quando a esquerda do bat tá maior do que a direita da bola e vice-versa
                let exit = (batCimaLeft > ballRight) | (batCimaRight < ballLeft);

                if (~exit) {
		            // Se a bola tocar na parte lateral esquerda,
		            // ela é rebatida para a diagonal esquerda
                    if (ballRight < (batCimaLeft + 10)) { let bouncingDirection = -1; }

                    else {
			            // Se a bola tocar na parte lateral direita,
			            // ela é rebatida para a diagonal direita
                        if (ballLeft > (batCimaRight - 10)) { let bouncingDirection = 1; }
                    }
		            /*
		            Trecho de código que diminui o tamanho da bat (adaptar para modos de jogo, posteriormente):
		            let bat_cima_width = bat_cima_width - 2;
            	        do bat_cima.setWidth(bat_cima_width);
		            */
		    }
            else {
            // Se a bola tocar na parede inferior
                if (wall = 4) {
                    // boolean "exit" se refere a quando a bola não toca no bat
                    // Ou seja, quando a esquerda do bat tá maior do que a direita da bola e vice-versa
                    let exit = (batBaixoLeft > ballRight) | (batBaixoRight < ballLeft);

                    if (~exit) {
                        if (ballRight < (batBaixoLeft + 10)) { let bouncingDirection = -1; }
                        else {
                            if (ballLeft > (batBaixoRight - 10)) { let bouncingDirection = 1; }
                        }
                    }
                    /*
                        let bat_baixo_width = bat_cima_width - 2;
                                do bat_baixo.setWidth(bat_baixo_width); 
                    */
                }
            }
        }
        }
        // ricocheteia a bola
        do ball.bounce(bouncingDirection);
	    // retorna o exit que pode indicar que o jogo terminou, a bola tocou na barra superior ou inferior
        return;
    }

    method void finalScreen() {
        var char key;

        let key = 0;	

        while(~(key = 140) & ~(key = 32)) {
            do Output.moveCursor(12, 18); // issue: centralizar essas duas mensagens na tela
            do Output.printString("Pressione ESC para Sair");
            do Output.moveCursor(13, 15);
            do Output.printString("Pressione SPACE para Jogar Novamente");

            let key = Keyboard.keyPressed();
        }
        // Se ESC for pressionado, o repetir também acaba
        if (key = 140) {
            let repetir = false; // variável de controle de repetição define que o run termine definitivamente
        }
        else {
            if (key = 32) {
                let exit = false; // variável de controle reinicia o exit para que o run rode novamente normalmente
            }
        }
        return;
    }
}