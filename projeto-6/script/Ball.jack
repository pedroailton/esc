class Ball {
    field int x, y; // Ponto de origem da sprite da bola: borda superior esquerda (em pixels)

    field boolean color;

    // distância até o destino da bola: deslocamento horizontal e vertical (em pixels)
    field int lengthx, lengthy; // são decrementadas à medida que a bola se move até chegarem a zero

    // parâmetros do algoritmo tipo Bresenham
    field int d; // acumulador usado para decidir quando dar o passo vertical vs. horizontal
    field int straightD; // incremento quando erro < 0 (movimento apenas no eixo principal)
    field int diagonalD; // incremento quando erro >= 0 (movimento nos dois ueixos)

    field boolean invert; // indica se o movimento é mais horizontal ou mais vertical (true -> eixo principal = Y, eixo secundário = X; false -> eixo principal = X, eixo vertical = Y)
    field boolean positivex; // direção em X (true = positivo / para a direita)
    field boolean positivey; // direção em Y (true = positivo / para baixo)

    field int leftWall, rightWall, topWall, bottomWall;  // limites (ajustados para o tamanho da bola)
    field int wall;   // Última parede que a bola tocou (0 = nenhuma, 1=left, 2=right, 3=top, 4=bottom)

    /** Constructs a new ball with the given initial location and wall locations. */
    constructor Ball new(int Ax, int Ay, int AleftWall, int ArightWall, int AtopWall, int AbottomWall) {    	
        let x = Ax;
        let y = Ay;

        let leftWall = AleftWall;
        let rightWall = ArightWall - 6;    // -6 for ball size
        let topWall = AtopWall; 
        let bottomWall = AbottomWall - 6;  // -6 for ball size

        let wall = 0;

        let lengthx = 0;
        let lengthy = 0;

        // Variáveis para o algoritmo de movimentação de Bresenham, utilizado em .move()
        let d = 0;
        let straightD = 0;
        let diagonalD = 0;
        let invert = false; // por padrão, o eixo principal é X e o secundário é Y
        let positivex = true;
        let positivey = true;

        let color = true; // por padrão, a bola tem cor preta

        do show(); // desenha a bola na tela

        return this; // retorna o objeto criado pela classe para PongGame.jack
    }

    method void setColor(boolean new_color) {
        let color = new_color;
        return;
    }

    /** Deallocates the Ball's memory. */
    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    /** Shows the ball. */
    method void show() {
        do Screen.setColor(color);
        do draw();
        return;
    }

    /** Hides the ball. */
    method void hide() {
        do Screen.setColor(~color);
        do draw();
        return;
    }

    /** Draws the ball. */
    method void draw() {
        do Screen.drawRectangle(x, y, x + 5, y + 5);
        return;
    }

    /** Returns the ball's left edge. */
    method int getLeft() {
        return x;
    }

    /** Returns the ball's right edge. */
    method int getRight() {
        return x + 5;
    }

    /** Calcula e define o destino da bola.*/
    method void setDestination(int destx, int desty) {
        var int dx, dy, temp;

        // calcula deslocamentos (quanto falta ir)
        let lengthx = destx - x; // destino - posição x atual
        let lengthy = desty - y; // destino - posição y atual

        // valores absolutos para o algoritmo discretizado (Bresenham)
        let dx = Math.abs(lengthx);
        let dy = Math.abs(lengthy);

        // decide se devemos "inverter" eixos (movimento mais vertical que horizontal)
        // se a distância até o destino para y for maior do que o para x,  o eixo principal de movimento é y
        // e o invert é true
        let invert = (dx < dy);

        if (invert) {
            // troca dx, dy para o algoritmo (trabalhamos sempre com dx >= dy internamente)
            let temp = dx;
            let dx = dy;
            let dy = temp;
        }

        // direção verdadeira em cada eixo (com base no sinal do deslocamento original)
        let positivex = (lengthx > 0); // true->direita
        let positivey = (lengthy > 0); // true->baixo (coord. y aumenta para baixo na tela)

        // inicializa os parâmetros do algoritmo tipo Bresenham
        // d começa em 2*dy - dx
        let d = (2 * dy) - dx;
        let straightD = 2 * dy;
        let diagonalD = 2 * (dy - dx); // valor sempre negativo ou 0

        return;
    }

     /**
     * Move a bola uma unidade em direção ao seu destino.
     * Retorna 0 se já estiver no destino
     * Utiliza o algoritmo de Bresenham, útil para movimentos em reta utilizando apenas inteiros
     */
    method int move() {
        var int STEP; // variável que indica o tamanho do passo (step) de cada .move() da bola
        let STEP = 1; // o step será 1

        do hide(); // apaga sempre a posição anterior da bola

        // Se já está no destino, não se move
        if ((lengthx = 0) & (lengthy = 0)) {
            do show();
            return 0; // indica colisão
        }

        // Atualiza o acumulador d (Bresenham)
        if (d < 0) {
            let d = d + straightD;
        }
        else {
            let d = d + diagonalD;

            // Passo no Eixo Secundário (Menor)
            // Se invertido, o eixo secundário é X
            if (invert) {
                // Se a direção é pra direita (positivex = true)
                if (positivex) { 
                    let x = x + STEP; // a bola se move no eixo horizontal para a direita
                    if (lengthx > 0) { let lengthx = lengthx - STEP; } // decrementa a distância absoluta até o destino, horizontalmente (aproximação)
                }
                // Se não, a direção é para esquerda (positivex = false)
                else { 
                    let x = x - STEP; //a bola se move no eixo horizontal para a esquerda
                    if (lengthx < 0) { let lengthx = lengthx + STEP; } // incrementa a distância absoluta até o destino, horizontalmente
                }
            }
            else {
                // Se normal, o eixo secundário é Y
                // Se a direção é para baixo (positivey = true)
                if (positivey) { 
                    let y = y + STEP; // a bola se move no eixo vertical para baixo
                    if (lengthy > 0) { let lengthy = lengthy - STEP; } // a distância absoluta até o destino é decrementada (aproximação)
                }
                // Se a direção é para cima (positivey = false)
                else { 
                    let y = y - STEP; // a bola se move no eixo vertical para cima
                    if (lengthy < 0) { let lengthy = lengthy + STEP; } // a distância absoluta até o destino é incrementada
                }
            }
        }

        // Passo no Eixo Principal (Maior)
        if (invert) {
            // Se invertido, o eixo principal é Y
            if (positivey) { 
                let y = y + STEP; // passo no eixo vertical para baixo
                if (lengthy > 0) { let lengthy = lengthy - STEP; } // aproximação do destino (lengthy = 0)
            }
            else { 
                let y = y - STEP; // passo no eixo vertical para cima
                if (lengthy < 0) { let lengthy = lengthy + STEP; }
            }
        }
        else {
            // Se normal, o eixo principal é X
            if (positivex) { 
                let x = x + STEP; // passo no eixo horizontal para a direita
                if (lengthx > 0) { let lengthx = lengthx - STEP; }
            }
            else { 
                let x = x - STEP; // passo no eixo horizontal para a esquerda
                if (lengthx < 0) { let lengthx = lengthx + STEP; }
            }
        }

        // Verifica colisão com as paredes
        let wall = 0;

        // se a bola está mais a esquerda do que a parede esquerda, está fora e colidiu
        if (x < leftWall) {
            let wall = 1;
            let x = leftWall;
        }
        // se a bola está mais a direita do que a parede direita, está fora e colidiu
        if (x > rightWall) {
            let wall = 2;
            let x = rightWall;
        }

        // se a bola está mais acima do que a parede de cima, está fora e colidiu
        if (y < topWall) {
            let wall = 3;
            let y = topWall;
        }

        // se a bola está mais abaixo do que a parede de baixo, está fora e colidiu
        if (y > bottomWall) {
            let wall = 4;
            let y = bottomWall;
        }

        // Se bateu na parede, zera o destino para forçar recálculo no método bounce
        if (~(wall = 0)) {
            let lengthx = 0;
            let lengthy = 0;
        }

        do show();
        return wall;
    }

    /**
    * Rebate na parede atual: define o novo destino da bola de acordo com o ângulo da bola e a direção de ricochete.
    * (-1/0/1=left/center/right)
    */
    method void bounce(int bouncingDirection) {
        // ...
        var int newx, newy;

        // Define uma distancia longa suficiente para o alvo
        // O que importa é esse valor ser maior do que um possível caminho da bola
        // uma vez que quando ela tocar na bola esse valor, a função de bouncing é ativada
        // mesmo não alcançando essa distância
        // e ela é usada novamente para definir um novo destino
        var int dist;
        let dist = 600; 
        
        // Se bateu na esquerda (1), deve ir para a direita
        if (wall = 1) {
            let newx = rightWall;

            // Mantém a direção vertical que já tinha
            // atualiza a distância até o destino, para que ele não zere antes da hora
            if (positivey) { let newy = y + dist; }

            // positivey = true -> cima
            else { let newy = y - dist; }
        }

        else {
            // Se bateu na direita (2), deve ir para a esquerda
            if (wall = 2) {
                let newx = leftWall;
                if (positivey) { let newy = y + dist; }
                else { let newy = y - dist; }
            }
            else {
                // Se bateu no topo (3), deve ir para baixo
                if (wall = 3) {
                    let newy = bottomWall;
                    // Mantém a direção horizontal que já tinha
                    if (positivex) { let newx = x + dist; }
                    else { let newx = x - dist; }
                }
                else {
                    // Se bateu embaixo (4), deve ir para cima
                    let newy = topWall;
                    if (positivex) { let newx = x + dist; }
                    else { let newx = x - dist; }
                }
            }
        }

        // Aplica o efeito da raquete (bouncingDirection)
        // O bouncingDirection vem como -1 (cima/esq) ou 1 (baixo/dir)
        // Ajustamos apenas o Y quando batemos nas laterais para simplificar
        if ((wall = 1) | (wall = 2)) {
            let newy = newy + (bouncingDirection * 50);
        }

        do setDestination(newx, newy);
        return;
    }

    method void explodeAnimation() {
        var int memAddress;
        var int location;

        // y * 32: Como cada linha tem 32 palavras de largura, multiplicar y por 32 faz você descer verticalmente até a linha correta.
        // x / 16: Como cada endereço guarda 16 pixels, dividir x por 16 diz em qual "bloco" horizontal você está.
        let location = ((Math.multiply(y, 32)) + (Math.divide(x, 16)));

        do hide(); // apaga a bola

        // FRAMES DESENVOLVIDOS NO BITMAP.EDITOR
        // Frame 1
        let memAddress = 16384+location;
        do Memory.poke(memAddress+0, 0);
        do Memory.poke(memAddress+32, 0);
        do Memory.poke(memAddress+64, 0);
        do Memory.poke(memAddress+96, 384);
        do Memory.poke(memAddress+128, 576);
        do Memory.poke(memAddress+160, 1440);
        do Memory.poke(memAddress+192, 2640);
        do Memory.poke(memAddress+224, 5160);
        do Memory.poke(memAddress+256, 2640);
        do Memory.poke(memAddress+288, 1440);
        do Memory.poke(memAddress+320, 576);
        do Memory.poke(memAddress+352, 384);
        do Memory.poke(memAddress+384, 0);
        do Memory.poke(memAddress+416, 0);
        do Memory.poke(memAddress+448, 0);
        do Memory.poke(memAddress+480, 0);

        // Frame 2
        do Memory.poke(memAddress+0, 256);
        do Memory.poke(memAddress+32, 640);
        do Memory.poke(memAddress+64, 256);
        do Memory.poke(memAddress+96, 4096);
        do Memory.poke(memAddress+128, 10624);
        do Memory.poke(memAddress+160, 4674);
        do Memory.poke(memAddress+192, 1189);
        do Memory.poke(memAddress+224, 18706);
        do Memory.poke(memAddress+256, -21872);
        do Memory.poke(memAddress+288, 17442);
        do Memory.poke(memAddress+320, 581);
        do Memory.poke(memAddress+352, 4482);
        do Memory.poke(memAddress+384, 10256);
        do Memory.poke(memAddress+416, 4136);
        do Memory.poke(memAddress+448, 16);
        do Memory.poke(memAddress+480, 0);

        return;
    }
}
